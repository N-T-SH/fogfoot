{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "api",
    "src/dots/coverage.ts",
    "src/dots/coverage.test.ts",
    "src/capture/rules.ts",
    "src/capture/rules.test.ts",
    "src/spike/measure.ts"
  ]
}
