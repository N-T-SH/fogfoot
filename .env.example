# Copy to .env (gitignored) for local development. Never commit real values.
# In production these live in Cloudflare Worker secrets and GitHub Actions secrets.

# Mapillary (batch pipeline only)
MAPILLARY_TOKEN=
MAPILLARY_ORG_ID=

# Sign-in (Vercel project environment variables). Sign-in is only enforced when BOTH are set.
# Google client ID is public by design; restrict its authorised JavaScript origins to your site.
GOOGLE_CLIENT_ID=
# Any random string of 32+ characters, e.g. `openssl rand -base64 48`. Signs sessions and hashes Google ids. Rotating it signs everyone out.
SESSION_SECRET=

# Cloudflare R2 (batch pipeline: scoped to one bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Scoring model endpoint (optional, only if using a hosted endpoint)
FOGFOOT_VLM_ENDPOINT=
FOGFOOT_VLM_MODEL=
FOGFOOT_VLM_API_KEY=
FOGFOOT_FT_BASE=
